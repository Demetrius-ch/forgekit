package main

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{ .ModulePath }}/internal/infrastructure/config"
	"{{ .ModulePath }}/internal/infrastructure/postgres"
	transport "{{ .ModulePath }}/internal/transport/http"
)

func main() {
	logger := slog.New(slog.NewJSONHandler(os.Stdout, &slog.HandlerOptions{Level: slog.LevelInfo}))

	cfg, err := config.Load()
	if err != nil {
		logger.Error("configuration invalide", "error", err)
		os.Exit(1)
	}

	ctx := context.Background()
	pool, err := postgres.NewPool(ctx, cfg.DatabaseURL)
	if err != nil {
		logger.Error("connexion postgres impossible", "error", err)
		os.Exit(1)
	}
	defer pool.Close()

	userRepo := postgres.NewUserRepository(pool)
	router := transport.NewRouter(logger, pool, userRepo)
	server := transport.NewServer(cfg.HTTPAddr, router, logger)

	errCh := make(chan error, 1)
	go func() {
		logger.Info("serveur démarré", "addr", cfg.HTTPAddr, "project", "{{ .ProjectName }}")
		if err := server.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			errCh <- err
		}
	}()

	stop := make(chan os.Signal, 1)
	signal.Notify(stop, syscall.SIGINT, syscall.SIGTERM)

	select {
	case err := <-errCh:
		logger.Error("serveur arrêté avec erreur", "error", err)
		os.Exit(1)
	case sig := <-stop:
		logger.Info("signal reçu, arrêt graceful", "signal", sig.String())
	}

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	if err := server.Shutdown(shutdownCtx); err != nil {
		logger.Error("arrêt graceful impossible", "error", err)
		os.Exit(1)
	}
	logger.Info("serveur arrêté proprement")
}

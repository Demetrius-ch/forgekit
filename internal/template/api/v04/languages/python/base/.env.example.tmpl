# Application
APP_NAME={{ .ProjectName }}
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT={{ .HTTP_PORT }}

# Database
DATABASE_URL={{ if eq .ProjectConfig.Database "postgres" }}postgresql://postgres:postgres@localhost:5432/{{ .DatabaseName }}{{ else if eq .ProjectConfig.Database "mysql" }}mysql://root:root@localhost:3306/{{ .DatabaseName }}{{ else if eq .ProjectConfig.Database "sqlite" }}sqlite:///./{{ .DatabaseName }}.db{{ else }}{{ end }}

# JWT (if auth enabled)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

from fastapi import FastAPI

from interfaces.http.health_router import router as health_router


def create_app() -> FastAPI:
    application = FastAPI(
        title="{{ .ProjectName }} API",
        description="{{ .ProjectName }} API with hexagonal architecture",
        version="1.0.0",
    )

    application.include_router(health_router, prefix="/api/v1")

    return application

{
  "name": "{{ .ProjectName }}",
  "version": "1.0.0",
  "description": "{{ .ProjectName }} API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate"
  },
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0"{{ if eq .ProjectConfig.Authentication "jwt" }},
    "jsonwebtoken": "^9.0.2"{{ end }}
  },
  "devDependencies": {
    "@types/express": "^4.17.21",{{ if eq .ProjectConfig.Authentication "jwt" }}
    "@types/jsonwebtoken": "^9.0.5",{{ end }}
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "tsx": "^4.6.2",
    "vitest": "^1.1.0",
    "prisma": "^5.7.0"
  }
}

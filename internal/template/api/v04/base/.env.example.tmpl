HTTP_PORT={{ .HTTPPort }}
HTTP_ADDR=0.0.0.0:{{ .HTTPPort }}
{{- if eq .ProjectConfig.Database "postgres" }}
DATABASE_URL=postgres://postgres:postgres@localhost:{{ .DBHostPort }}/{{ .DatabaseName }}?sslmode=disable
{{- else if eq .ProjectConfig.Database "mysql" }}
DATABASE_URL=forgekit:forgekit@tcp(localhost:{{ .DBHostPort }})/{{ .DatabaseName }}?parseTime=true
{{- else if eq .ProjectConfig.Database "sqlite" }}
DATABASE_URL=file:{{ .DatabaseName }}.db?_pragma=foreign_keys(1)
{{- end }}
{{- if eq .ProjectConfig.Authentication "jwt" }}
JWT_SECRET=change-me-in-production
{{- end }}

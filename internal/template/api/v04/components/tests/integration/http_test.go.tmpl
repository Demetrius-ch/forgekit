package tests

import (
	"net/http"
	"net/http/httptest"
	"testing"
)

// This integration test exercises the assembled HTTP boundary without requiring
// Docker or an externally running database.
func TestHealthHTTPIntegration(t *testing.T) {
	response := httptest.NewRecorder()
	newRouter().ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/health", nil))
	if response.Code != http.StatusOK {
		t.Fatalf("status = %d, want %d", response.Code, http.StatusOK)
	}
}

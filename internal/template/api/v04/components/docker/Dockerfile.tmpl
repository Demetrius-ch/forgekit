{{- if eq .ProjectConfig.Language "go" }}
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/server ./cmd/server

FROM alpine:3.21
RUN adduser -D -H app
USER app
COPY --from=build /out/server /server
EXPOSE {{ .HTTP_PORT }}
ENTRYPOINT ["/server"]
{{- else if eq .ProjectConfig.Language "python" }}
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN adduser --disabled-password --gecos "" app
USER app

EXPOSE {{ .HTTP_PORT }}

CMD ["python", "main.py"]
{{- else if or (eq .ProjectConfig.Language "typescript") (eq .ProjectConfig.Language "javascript") }}
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
{{- if eq .ProjectConfig.Language "typescript" }}
RUN npm ci

COPY . .
RUN npm run build && npm prune --omit=dev
{{- else }}
RUN npm ci --only=production

COPY . .
{{- end }}

RUN addgroup -g 1001 -S app && adduser -S app -u 1001
USER app

EXPOSE {{ .HTTP_PORT }}

CMD ["node", "{{ if eq .ProjectConfig.Language "typescript" }}dist/index.js{{ else }}src/index.js{{ end }}"]
{{- else }}
FROM alpine:3.21
RUN adduser -D -H app
USER app
EXPOSE {{ .HTTP_PORT }}
{{- end }}

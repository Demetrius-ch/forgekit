services:
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ .DatabaseName }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ .DatabaseName }}"]
      interval: 5s
      timeout: 5s
      retries: 10
    ports:
      - "{{ .PostgresHostPort }}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  api:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      HTTP_ADDR: "0.0.0.0:8080"
      DATABASE_URL: "postgres://postgres:postgres@postgres:5432/{{ .DatabaseName }}?sslmode=disable"
{{- if eq .ProjectConfig.Authentication "jwt" }}
      JWT_SECRET: "${JWT_SECRET:?set JWT_SECRET in .env}"
{{- end }}
    ports:
      - "{{ .HTTPPort }}:8080"

volumes:
  postgres_data:

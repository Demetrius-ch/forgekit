services:
  {{- if not .USE_EXISTING_DB }}
  postgres:
    image: postgres:16-alpine
    container_name: {{ .ProjectName }}-postgres
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ .DatabaseName }}
    ports:
      - "{{ .PostgresHostPort }}:5432"
    volumes:
      - {{ .ProjectName }}_postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ .DatabaseName }}"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    networks:
      - {{ .ProjectName }}_network
  {{- else if .EXTERNAL_DB_HOST }}
  {{- else }}
  postgres:
    image: postgres:16-alpine
    container_name: {{ .ProjectName }}-postgres
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: postgres
    ports:
      - "{{ .PostgresHostPort }}:5432"
    volumes:
      - {{ .ProjectName }}_postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    networks:
      - {{ .ProjectName }}_network
  {{- end }}

  {{- if .USE_EXISTING_DB }}
  {{- if .EXTERNAL_DB_HOST }}
  migrate:
    image: migrate/migrate:v4.18.1
    volumes:
      - ../migrations:/migrations
    command:
      [
        "-path", "/migrations",
        "-database", "postgres://{{ .EXTERNAL_DB_USER }}:{{ .EXTERNAL_DB_PASSWORD }}@{{ .EXTERNAL_DB_HOST }}:{{ .EXTERNAL_DB_PORT }}/{{ .EXTERNAL_DB_NAME }}?sslmode=disable",
        "up"
      ]
    restart: "no"
  {{- else }}
  migrate:
    image: migrate/migrate:v4.18.1
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - ../migrations:/migrations
    command:
      [
        "-path", "/migrations",
        "-database", "postgres://postgres:postgres@postgres:5432/{{ .DatabaseName }}?sslmode=disable",
        "up"
      ]
    restart: on-failure:3
    networks:
      - {{ .ProjectName }}_network
  {{- end }}
  {{- else }}
  migrate:
    image: migrate/migrate:v4.18.1
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - ../migrations:/migrations
    command:
      [
        "-path", "/migrations",
        "-database", "postgres://postgres:postgres@postgres:5432/{{ .DatabaseName }}?sslmode=disable",
        "up"
      ]
    restart: on-failure:3
    networks:
      - {{ .ProjectName }}_network
  {{- end }}

  {{- if .USE_EXISTING_DB }}
  {{- if .EXTERNAL_DB_HOST }}
  api:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    container_name: {{ .ProjectName }}-api
    depends_on:
      migrate:
        condition: service_completed_successfully
    env_file:
      - ../.env
    environment:
      HTTP_PORT: "{{ .HTTPPort }}"
      HTTP_ADDR: "0.0.0.0:{{ .HTTPPort }}"
      DATABASE_URL: postgres://{{ .EXTERNAL_DB_USER }}:{{ .EXTERNAL_DB_PASSWORD }}@{{ .EXTERNAL_DB_HOST }}:{{ .EXTERNAL_DB_PORT }}/{{ .EXTERNAL_DB_NAME }}?sslmode=disable
      CORS_ENABLED: "${CORS_ENABLED:-false}"
      CORS_ALLOWED_ORIGINS: "${CORS_ALLOWED_ORIGINS:-http://localhost:3000}"
      CORS_ALLOWED_METHODS: "${CORS_ALLOWED_METHODS:-GET,POST,PUT,PATCH,DELETE,OPTIONS}"
      CORS_ALLOWED_HEADERS: "${CORS_ALLOWED_HEADERS:-Content-Type,Authorization}"
      CORS_ALLOW_CREDENTIALS: "${CORS_ALLOW_CREDENTIALS:-false}"
    ports:
      - "{{ .HTTPPort }}:{{ .HTTPPort }}"
    restart: unless-stopped
  {{- else }}
  api:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    container_name: {{ .ProjectName }}-api
    depends_on:
      migrate:
        condition: service_completed_successfully
    env_file:
      - ../.env
    environment:
      HTTP_PORT: "{{ .HTTPPort }}"
      HTTP_ADDR: "0.0.0.0:{{ .HTTPPort }}"
      DATABASE_URL: postgres://postgres:postgres@postgres:5432/{{ .DatabaseName }}?sslmode=disable
      CORS_ENABLED: "${CORS_ENABLED:-false}"
      CORS_ALLOWED_ORIGINS: "${CORS_ALLOWED_ORIGINS:-http://localhost:3000}"
      CORS_ALLOWED_METHODS: "${CORS_ALLOWED_METHODS:-GET,POST,PUT,PATCH,DELETE,OPTIONS}"
      CORS_ALLOWED_HEADERS: "${CORS_ALLOWED_HEADERS:-Content-Type,Authorization}"
      CORS_ALLOW_CREDENTIALS: "${CORS_ALLOW_CREDENTIALS:-false}"
    ports:
      - "{{ .HTTPPort }}:{{ .HTTPPort }}"
    restart: unless-stopped
    networks:
      - {{ .ProjectName }}_network
  {{- end }}
  {{- else }}
  api:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    container_name: {{ .ProjectName }}-api
    depends_on:
      migrate:
        condition: service_completed_successfully
    env_file:
      - ../.env
    environment:
      HTTP_PORT: "{{ .HTTPPort }}"
      HTTP_ADDR: "0.0.0.0:{{ .HTTPPort }}"
      DATABASE_URL: postgres://postgres:postgres@postgres:5432/{{ .DatabaseName }}?sslmode=disable
      CORS_ENABLED: "${CORS_ENABLED:-false}"
      CORS_ALLOWED_ORIGINS: "${CORS_ALLOWED_ORIGINS:-http://localhost:3000}"
      CORS_ALLOWED_METHODS: "${CORS_ALLOWED_METHODS:-GET,POST,PUT,PATCH,DELETE,OPTIONS}"
      CORS_ALLOWED_HEADERS: "${CORS_ALLOWED_HEADERS:-Content-Type,Authorization}"
      CORS_ALLOW_CREDENTIALS: "${CORS_ALLOW_CREDENTIALS:-false}"
    ports:
      - "{{ .HTTPPort }}:{{ .HTTPPort }}"
    restart: unless-stopped
    networks:
      - {{ .ProjectName }}_network
  {{- end }}

{{- if not .USE_EXISTING_DB }}
volumes:
  {{ .ProjectName }}_postgres_data:
networks:
  {{ .ProjectName }}_network:
    driver: bridge
{{- else if not .EXTERNAL_DB_HOST }}
volumes:
  {{ .ProjectName }}_postgres_data:
networks:
  {{ .ProjectName }}_network:
    driver: bridge
{{- end }}

#!/usr/bin/make -f

%:
	dh $@ --buildsystem=golang --with=golang

override_dh_auto_build:
	CGO_ENABLED=0 go build -ldflags="-s -w -X github.com/Demetrius-ch/forgekit/internal/app.Version=$(DEB_VERSION_UPSTREAM)" -o forgekit ./cmd/forge

override_dh_auto_install:
	dh_auto_install
	# Install forgekit binary
	install -D -m 755 forgekit debian/forgekit/usr/bin/forgekit
	# Create forge symlink for backward compatibility
	ln -sf forgekit debian/forgekit/usr/bin/forge
	# Install AppStream metadata
	install -D -m 644 packaging/com.forgekit.ForgeKit.metainfo.xml debian/forgekit/usr/share/metainfo/com.forgekit.ForgeKit.metainfo.xml
	# Install icon
	install -D -m 644 packaging/icons/hicolor/scalable/apps/forgekit.svg debian/forgekit/usr/share/icons/hicolor/scalable/apps/forgekit.svg

override_dh_installchangelogs:
	dh_installchangelogs debian/changelog

override_dh_installdocs:
	dh_installdocs